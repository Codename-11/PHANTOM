# PHANTOM Configuration

# Server port the Express API listens on. The Vite dev proxy targets this.
# PHANTOM_API_PORT is preferred; PORT is honored as a fallback for direct
# `node server/index.js` workflows.
PHANTOM_API_PORT=1337

# ─── LLM Provider ────────────────────────────────────────────────────────────
# API_PROVIDER picks an entry from server/ai/providers.js. The default is
# `hermes` — a local OAuth-backed proxy that fronts Claude Pro / ChatGPT Pro
# / SuperGrok subscriptions as one OpenAI-compatible endpoint. Other
# options: openai · xai · openrouter · groq · deepseek · together · ollama
# · lmstudio · custom.
API_PROVIDER=hermes

# API_BASE_URL is auto-derived from the provider above and overridden by
# Settings → Provider in the UI. Set it explicitly here only when running
# `custom` or pointing at a self-hosted endpoint that doesn't match the
# registry's default.
# API_BASE_URL=http://127.0.0.1:8645/v1

# API_KEY is the bearer token sent in the Authorization header. The Hermes
# proxy accepts any value (it attaches your real OAuth credentials per
# request); direct vendors require their real key. Leave blank for local
# Ollama / LM Studio.
API_KEY=

# Model the assistant uses. For Hermes, route by model slug — e.g.
# grok-4.3 routes to xAI OAuth, gpt-5.4 routes to OpenAI OAuth.
MODEL_ID=grok-4.3

TEMPERATURE=0.7
MAX_TOKENS=4096
